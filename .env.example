# Postgres (Neon / Vercel Postgres) — POOLED bağlantı dizesi ("-pooler" içeren host)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Oturum çerezini imzalar.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="..."

# Kayıt olmayı kısıtlar — bu kodu bilmeyen hesap açamaz.
REGISTER_CODE="..."

# NOT: .env içinde her "$" karakterini "\$" olarak kaçır.
# Next.js "$..." ifadelerini genişletiyor ve bcrypt/base64 değerlerini bozuyor.

# Web push (dürtme bildirimi). Anahtarları üret: npx web-push generate-vapid-keys --json
# Bunlar tanımlı değilse bildirim özelliği kendiliğinden kapalı kalır, uygulama çalışmaya devam eder.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:seninmailin@ornek.com"
