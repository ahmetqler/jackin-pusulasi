// Jack'in Pusulası — veri modeli
//
// Gizlilik ilkesi: kullanıcı başına TEK, üzerine yazılan konum satırı tutulur.
// Location.userId birincil anahtar olduğu için konum geçmişi biriktirmek
// yapısal olarak imkânsız. Koordinatlar bu tablonun dışına asla çıkmaz —
// dışarıya sadece src/lib/radar.ts içindeki buildRadarPayload() yön ve
// mesafe üretir.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  displayName  String
  passwordHash String
  friendCode   String   @unique
  /// Kullanıcının kendi seçtiği yıldız rengi (hex). Arkadaşları bu renkte görür.
  color        String   @default("#e8c37a")
  sharing      Boolean  @default(true)
  /// Arkadaşları "uygulamayı aç" bildirimi gönderebilsin mi.
  acceptsNudges Boolean @default(true)
  createdAt    DateTime @default(now())

  location          Location?
  sentRequests      Friendship[] @relation("SentRequests")
  receivedRequests  Friendship[] @relation("ReceivedRequests")
  pushSubscriptions PushSubscription[]
  nudgesSent        Nudge[]      @relation("NudgeFrom")
  nudgesReceived    Nudge[]      @relation("NudgeTo")
}

/// Bir cihazın bildirim aboneliği. Kullanıcı birden fazla cihazdan girebilir.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Dürtme hız sınırı. Yön başına TEK satır, üzerine yazılır — kimin kimi ne
/// zaman dürttüğünün geçmişi tutulmuyor, sadece "en son ne zaman" bilgisi.
model Nudge {
  fromId String
  toId   String
  sentAt DateTime @default(now())

  from User @relation("NudgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("NudgeTo", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
}

/// Son bilinen konum. userId PRIMARY KEY -> satır her zaman üzerine yazılır,
/// geçmiş tutulmaz. Görünmez moda geçildiğinde bu satır tamamen silinir.
model Location {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lat       Float
  lng       Float
  accuracyM Int?
  updatedAt DateTime @default(now())
}

model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  requester User @relation("SentRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("ReceivedRequests", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}
